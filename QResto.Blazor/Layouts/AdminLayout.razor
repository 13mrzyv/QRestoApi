@using QResto.Blazor.Services
@inherits LayoutComponentBase
@inject UserProvider userProvider
<div class="admin-wrapper">
    <!-- Əsas Məzmun -->
    <div class="main-content">
        <!-- Üst Panel (Header) -->
        <header class="topbar">
           
            <div class="sidebar-footer">
                <h1 class="page-title">İDARƏ PANELİ</h1>
                <button class="signout-btn" @onclick="SignOut">Çıxış</button>
            </div>

            <div class="topbar-actions">
                <div class="user-info">
                    <span class="user-name">@userProvider.Username (Admin)</span>
                    <div class="user-avatar">A</div>
                </div>
            </div>
        </header>

        <!-- Səhifə Məzmunu -->
        <main class="page-body">
            @Body
        </main>
    </div>
</div>

@code {
    private void SignOut()
    {
        // Çıxış məntiqi burada yazılacaq
        NavigationManager.NavigateTo("/login");
    }

    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
}

